      ],
      "id": "8f12e248-811a-46b3-830c-950e9ef11065",
      "name": "Group by Result Detail"
    },
    {
      "parameters": {
        "jsCode": "// Loop 內部的 Code 節點\nreturn $input.item.json.Matches.map(match => ({\n  json: match\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        128
      ],
      "id": "7966e52d-0f4a-43a8-9fc6-8b27e451c848",
      "name": "Get Result"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst output = [];\n\nitems.forEach(item => {\n  const data = item.json;\n  const matches = data.F24?.Mecze?.M;\n  \n  if (!Array.isArray(matches)) return;\n  \n  const matchesOutput = matches.map(match => {\n    const eventTimeStamp = match.C0 || 0;\n    const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n    const eventDate = date.toISOString().split('T')[0];\n    const eventTime = date.toISOString().replace('T', ' ').slice(0, 19);\n    \n    const s1 = match.S1 || '';\n    const s2 = match.S2 || '';\n    \n    // 擴充特殊情況條件\n    const isSpecial = typeof s1 === 'string' && (s1.includes('w.o.') || s1.includes('P-P') || s1.includes('CANC'));\n    \n    // 檢查 s2 長度是否大於 3\n    const isS2TooLong = typeof s2 === 'string' && s2.length > 3;\n    \n    return {\n      json: {\n        Cid: match.KId,\n        MId: match.MId || '',\n        EventDate: eventDate,\n        EventTime: eventTime,\n        PLeagueId: match._LId,\n        LeagueId: match.LId,\n        HomeName: match.HN || '',\n        AwayName: match.GN || '',\n        EventStatus: match.MStan,\n        HT: (isSpecial || isS2TooLong) ? null : s2, \n        FT: isSpecial ? null : s1, \n        AP: null,\n        AET: null,\n        HRedCard: match.HRCi || '',\n        ARedCard: match.GRCi || '',\n        Info: isSpecial ? s1 : (match.Info || ''),\n      }\n    };\n  });\n  \n  output.push(...matchesOutput);\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
