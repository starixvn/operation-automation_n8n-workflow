      "name": "Loop Over - Create sheet"
    },
    {
      "parameters": {
        "jsCode": "const output = $input.all().flatMap(item => {\n  const matches = item.json?.F24?.Mecze?.M;\n  \n  if (!Array.isArray(matches)) return [];\n  \n  // 計算一小時前的時間戳（秒）\n  const oneHourAgo = Math.floor(Date.now() / 1000) - (60 * 60 * 2);\n  \n  return matches\n    .filter(match => {\n      const s2 = match.S2 || '';\n      const eventTimeStamp = match.C0 || 0;\n      \n      const needToGetDetail = s2.length > 3;\n      const isAfterOneHourAgo = eventTimeStamp > oneHourAgo;\n      \n      return needToGetDetail && isAfterOneHourAgo;\n    })\n    .map(match => {\n      const eventTimeStamp = match.C0 || 0;\n      const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n      const eventDate = date.toISOString().split('T')[0];\n     \n      const s2 = match.S2 || '';\n      const needToGetDetail = s2.length > 3;\n      const url = 'https://www.futbol24.com/ml/matchActionXml/?MId=' + match.MId;\n      \n      return {\n        json: {\n          EventDate: eventDate,\n          MId: match.MId || '',\n          url: url,\n          needToGetDetail,\n          s2,\n        }\n      };\n    });\n});\n\nreturn output;"
      },
