      "id": "170e5e07-57ce-4ff8-b88a-28983ad69fd9",
      "name": "Loop Over - Create sheet"
    },
    {
      "parameters": {
        "jsCode": "const output = $input.all().flatMap(item => {\n  const matches = item.json?.F24?.Mecze?.M;\n  \n  if (!Array.isArray(matches)) return [];\n  \n  // 計算一小時前的時間戳（秒）\n  const oneHourAgo = Math.floor(Date.now() / 1000) - (60 * 60 * 2);\n  \n  return matches\n    .filter(match => {\n      const s2 = match.S2 || '';\n      const eventTimeStamp = match.C0 || 0;\n      \n      const needToGetDetail = s2.length > 3;\n      const isAfterOneHourAgo = eventTimeStamp > oneHourAgo;\n      \n      return needToGetDetail && isAfterOneHourAgo;\n    })\n    .map(match => {\n      const eventTimeStamp = match.C0 || 0;\n      const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n      const eventDate = date.toISOString().split('T')[0];\n     \n      const s2 = match.S2 || '';\n      const needToGetDetail = s2.length > 3;\n      const url = 'https://www.futbol24.com/ml/matchActionXml/?MId=' + match.MId;\n      \n      return {\n        json: {\n          EventDate: eventDate,\n          MId: match.MId || '',\n          url: url,\n          needToGetDetail,\n          s2,\n        }\n      };\n    });\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        -496
      ],
      "id": "b97b21cf-b07d-45e7-bf76-1f47be6672f8",
      "name": "Get Score Details"
    },
    {
      "parameters": {
        "jsCode": "// 假設 Get Score Details 的資料在 $('Get Score Details').all()\nconst scoreDetails = $('Get Score Details').all();\n\n// 建立 MId 到 EventDate 的對應表\nconst eventDateMap = {};\nscoreDetails.forEach(item => {\n  const mid = item.json?.MId;\n  const eventDate = item.json?.EventDate;\n  if (mid && eventDate) {\n    eventDateMap[mid] = eventDate;\n  }\n});\n\n// 處理當前資料\nconst output = $input.all().map(item => {\n  const MId = item.json?.Mecz?.id ?? '';\n  const events = item.json?.Mecz?.akcja;\n  \n  // 從對應表中取得 EventDate\n  const eventDate = eventDateMap[MId] || '';\n  \n  // 初始化結果物件\n  const result = {\n    EventDate: eventDate,\n    MId,\n    FT: null,\n    HT: null,\n    AP: null,\n    AET: null\n  };\n  \n  // 如果 events 是陣列，填入對應的比分\n  if (Array.isArray(events)) {\n    const validKeys = ['FT', 'HT', 'AP', 'AET'];\n    \n    events.forEach(event => {\n      if (validKeys.includes(event.m)) {\n        result[event.m] = `${event.H}-${event.G}`;\n      }\n    });\n  }\n  \n  return { json: result };\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
