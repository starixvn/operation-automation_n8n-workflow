      "id": "45ce0aa8-3099-4aa1-b967-f4a97e8d8464",
      "name": "XML to Json - Result Detail"
    },
    {
      "parameters": {
        "jsCode": "// 假設 Get Score Details 的資料在 $('Get Score Details').all()\nconst scoreDetails = $('Get Score Details').all();\n\n// 建立 MId 到 EventDate 的對應表\nconst eventDateMap = {};\nscoreDetails.forEach(item => {\n  const mid = item.json?.MId;\n  const eventDate = item.json?.EventDate;\n  if (mid && eventDate) {\n    eventDateMap[mid] = eventDate;\n  }\n});\n\n// 處理當前資料\nconst output = $input.all().map(item => {\n  const MId = item.json?.Mecz?.id ?? '';\n  const events = item.json?.Mecz?.akcja;\n  \n  // 從對應表中取得 EventDate\n  const eventDate = eventDateMap[MId] || '';\n  \n  // 初始化結果物件\n  const result = {\n    EventDate: eventDate,\n    MId,\n    FT: null,\n    HT: null,\n    AP: null,\n    AET: null\n  };\n  \n  // 如果 events 是陣列，填入對應的比分\n  if (Array.isArray(events)) {\n    const validKeys = ['FT', 'HT', 'AP', 'AET'];\n    \n    events.forEach(event => {\n      if (validKeys.includes(event.m)) {\n        result[event.m] = `${event.H}-${event.G}`;\n      }\n    });\n  }\n  \n  return { json: result };\n});\n\nreturn output;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2192,
        352
      ],
      "id": "583f720d-7191-419f-a799-133cf24e80ce",
