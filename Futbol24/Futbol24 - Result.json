    {
      "parameters": {
        "jsCode": "// 取得輸入資料\nconst jsons = $input.all();\nconst existingSheetNames = new Set(); // 用來追蹤已存在的 SheetName\n\n// 收集所有唯一的日期\njsons.forEach(item => {\n  const matches = item.json.F24?.Mecze?.M;\n  \n  if (!Array.isArray(matches)) return;\n  \n  matches\n    .forEach(match => {\n      const eventTimeStamp = match.C0 || 0;\n      const date = new Date((eventTimeStamp * 1000) + (8 * 60 * 60 * 1000));\n      const eventDate = date.toISOString().split('T')[0];\n      \n      existingSheetNames.add(eventDate);\n    });\n});\n\n// 轉換為輸出格式並排序\nconst output = Array.from(existingSheetNames)\n  .sort()\n  .map(date => ({\n    json: {\n      SheetName: date\n    }\n  }));\n\nreturn output;"
      },
