    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 按照 EventDate 分組\nconst groupedByDate = items.reduce((acc, item) => {\n  const eventDate = item.json.EventDate;\n  if (!acc[eventDate]) {\n    acc[eventDate] = [];\n  }\n  acc[eventDate].push(item.json);\n  return acc;\n}, {});\n\n// 將分組結果轉換為陣列格式並排序\nconst finalOutput = Object.entries(groupedByDate)\n  .sort(([dateA], [dateB]) => dateA.localeCompare(dateB))\n  .map(([date, matches]) => ({\n    json: {\n      EventDate: date,\n      Matches: matches\n    }\n  }));\n\nreturn finalOutput;"
      },
