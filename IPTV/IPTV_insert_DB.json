    {
      "parameters": {
        "jsCode": "const today = new Date();\n\n// ➕ 8 小時\nconst todayPlus8 = new Date(today.getTime() + 8 * 60 * 60 * 1000);\n\n// 明天\nconst tomorrow = new Date();\ntomorrow.setDate(todayPlus8.getDate() + 1);\n\n// 格式化 yyyy-mm-dd\nfunction formatYYYYMMDD(date) {\n  return date.toISOString().split(\"T\")[0];\n}\n\n// 格式化 dd/mm/yyyy\n\n// 四個結果\nconst result = {\n  today_ymd: formatYYYYMMDD(todayPlus8),       // 2025-09-17 (UTC+8 後的日期)\n  tomorrow_ymd: formatYYYYMMDD(tomorrow),      // 2025-09-18\n};\n\n// 回傳給 n8n\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        16
      ],
      "id": "8ebbaa0d-8900-4770-a0e4-087a65fca8ad",
      "name": "Extract time"
    },
    {
      "parameters": {
        "jsCode": "// 每組 20 筆\nconst batchSize = 20;\n\n// 假設上游輸出在 $json.output 或 $json.events\nconst events = $input.first().json.data;\n\nconst batches = [];\nfor (let i = 0; i < events.length; i += batchSize) {\n  batches.push({\n    json: {\n      events: events.slice(i, i + batchSize)\n    }\n  });\n}\n\nreturn batches;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
