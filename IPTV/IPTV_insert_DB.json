    {
      "parameters": {
        "jsCode": "const input = $('Loop Over Items').first().json.events;   // 或直接你的原資料\nconst fake = $input.first().json.output;     // 另一組要用來\nconst result = {\n  output: input.map((item, index) => ({\n    ...item,\n    leagueName: fake[index]?.leagueName || item.leagueName\n  }))\n};\n\nreturn result;"
      },
