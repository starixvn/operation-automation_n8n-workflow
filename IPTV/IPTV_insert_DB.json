      "parameters": {
        "jsCode": "const input = $('Loop Over Items').first().json.events;   // 原始資料\nconst fake = $input.first().json.output;                   // 模型輸出結果\n\nconst result = {\n  output: input.map((item, index) => {\n    const country = fake[index]?.country || \"\";\n    const league = item.leagueName;\n    const joinedLeague = country ? `${country} ${league}` : league;\n\n    return {\n      ...item,\n      leagueName: joinedLeague\n    };\n  })\n};\n\nreturn result;"
