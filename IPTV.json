        "jsCode": "const raw = String($input.first().json.leagues);\n\nlet items = raw.split(\",\")// \n  .map(item => `\"${item}\"`);                   // 加上引號\nconst count = items.length;\nconst batches = Math.ceil(count / 50); \nreturn {\n  result: `[${items.join(\", \")}]`,\n  batches: batches*3\n};"
