        "jsCode": "const draw_data = $('When Executed by Another Workflow').first().json.draw_data;\nconst matches = $input.first().json.matches_data;\n\n// 過濾掉任一隊 player1 缺失的比賽\nconst filteredInput = matches.filter(match => match.player_home_1_id && match.player_away_1_id);\n\n\nfunction toCamel(input) {\n  return input.replace(/_([a-z0-9])/g, (_, letter) => letter.toUpperCase());\n}\n\nconst events = filteredInput.map(item => {\n  const row = item;\n\n  const converted = {};\n\n  // ⭐ 先把所有 Key 轉成 camelCase\n  Object.keys(row).forEach(k => {\n    converted[toCamel(k)] = row[k];\n  });\n\n  // ⭐ 強制 league_id 為 integer\n  if (converted.leagueId !== undefined) {\n    converted.leagueId = parseInt(converted.leagueId, 10);\n  }\n\n  // ⭐ 覆寫/新增欄位\n  converted.isActive = true;\n  converted.status = false;\n  converted.kickoffTime = new Date(converted.kickoffTime).toISOString();\n\n  // ⭐ 替換 player null name / country 變空字串（更乾淨）\n  if (converted.playerHome2Name == null) converted.playerHome2Name = \"\";\n  if (converted.playerAway2Name == null) converted.playerAway2Name = \"\";\n  if (converted.playerHome2Country == null) converted.playerHome2Country = \"\";\n  if (converted.playerAway2Country == null) converted.playerAway2Country = \"\";\n\n  return converted;\n});\n\n// ✅ 最後包成 events\nreturn { json: { events } };\n"
      },
