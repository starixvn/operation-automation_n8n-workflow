    {
      "parameters": {
        "jsCode": "const draw_data = $('When Executed by Another Workflow').first().json.draw_data;\nconst matches = $input.first().json.matches_data;\n\n// 過濾掉任一隊 player1 缺失的比賽\nconst filteredInput = matches.filter(match => match.player_home_1_id && match.player_away_1_id);\n\nfunction snake(input) {\n  return input.replace(/[A-Z]/g, letter => \"_\" + letter.toLowerCase());\n}\n\nreturn filteredInput.map(item => {\n  const row = item;\n\n  const converted = {};\n\n  // ⭐ 先把所有 Key 轉成 snake_case\n  Object.keys(row).forEach(k => {\n    converted[snake(k)] = row[k];\n  });\n\n  // ⭐ 強制 league_id 為 integer\n  if (converted.league_id !== undefined) {\n    converted.league_id = parseInt(converted.league_id, 10);\n  }\n\n  // ⭐ 覆寫/新增欄位\n  converted.is_active = true;\n  converted.status = false;\n\n  // ⭐ 替換 player null name / country 變空字串（更乾淨）\n  if (converted.player_home_2_name == null) converted.player_home_2_name = \"\";\n  if (converted.player_away_2_name == null) converted.player_away_2_name = \"\";\n  if (converted.player_home_2_country == null) converted.player_home_2_country = \"\";\n  if (converted.player_away_2_country == null) converted.player_away_2_country = \"\";\n\n  return converted;\n});"
      },
